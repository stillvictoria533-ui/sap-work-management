# Bootstrap server: only ACME challenges, never application traffic.
server {
    listen 80 default_server;
    server_name ${APP_DOMAIN};
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 404; }
}
