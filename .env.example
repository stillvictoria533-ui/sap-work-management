# Copy to .env.production. Never use these placeholders as production secrets.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=desk.example.com
CSRF_TRUSTED_ORIGINS=https://desk.example.com
TRUST_PROXY=true
APP_DOMAIN=desk.example.com
PUBLIC_BASE_URL=https://desk.example.com
# APP_DOMAIN also accepts a public IPv4 address. Never include a scheme or port.
ACME_EMAIL=
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=sapdesk
POSTGRES_USER=sapdesk
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
MEDIA_ROOT=/app/private-media

# Enable only after HTTPS, recipients and both DingTalk channels are configured.
DINGTALK_ENABLED=false
DINGTALK_GROUP_TOKEN=
DINGTALK_GROUP_SECRET=

# AI chat is separate from retired automatic ticket replies. SAP remains disconnected.
# disabled | codex | openai. Codex reuses the service user's CLI login (subscription quota).
AI_PROVIDER=disabled
AI_CODEX_BIN=codex
# Empty uses Codex's default model. Requires CLI >= 0.158.0.
AI_CODEX_MODEL=
# Only needed when AI_PROVIDER=openai. Never expose these in the frontend.
OPENAI_API_KEY=
OPENAI_MODEL=

# Local connector pilot; enable only for an explicitly reviewed deployment.
SAP_CONNECTOR_ENABLED=false
# Accepted-ticket follow-up; enable with the reviewed scheduler after deployment.
AI_TICKET_AUTOMATION_ENABLED=false
